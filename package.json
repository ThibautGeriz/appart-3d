{
  "name": "appart-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "encode:ktx2": "node scripts/encode-ktx2.ts",
    "export:glb": "node scripts/export-glb.ts",
    "validate:glb": "node scripts/export-glb.ts --no-meshopt --out .glb-check && for f in models/*.glb .glb-check/*.glb; do npx -y @gltf-transform/cli@4.1.1 validate --limit 20 \"$f\" || exit 1; done",
    "bake:lightmap": "node scripts/bake-lightmap.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "playwright test",
    "perf:report": "node scripts/perf-report.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "@playwright/test": "^1.65.1",
    "@types/three": "^0.187.0",
    "jpeg-js": "^0.4.4",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^0.22.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
